# Copy this file to .env and fill in real values. .env is git-ignored.
# On Vercel, set the same variables in Project Settings > Environment Variables.

# PostgreSQL connection string. Use Neon's POOLED string (the host contains
# "-pooler"). Locally, point this at the Neon "dev" branch.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The same database through the DIRECT connection (host without "-pooler").
# Only the migrate and seed commands use it: schema changes should not go
# through the pooler.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Port for the local API server (go run ./cmd/server). The Vite dev server
# forwards /api to this port.
PORT=8080

# Local development only: the session cookie normally has the Secure flag and
# the __Host- name prefix, which need HTTPS. Set this to 1 when running on
# plain http://localhost. Never set it on a real host.
INSECURE_COOKIES=1
